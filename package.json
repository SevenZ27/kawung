{
  "name": "kawung",
  "private": true,
  "version": "1.0.0",
  "description": "Generative batik-inspired phone wallpapers drawn from code",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vite --port 4174 --strictPort",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4174 --strictPort",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test --grep-invert @og",
    "og": "playwright test --grep @og"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "1.60.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.5.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.0"
  }
}
