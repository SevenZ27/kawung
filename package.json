{
  "name": "kawung",
  "private": true,
  "version": "1.0.0",
  "description": "Generative batik-inspired phone wallpapers drawn from code",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "models": "node scripts/restore-devices.mjs",
    "models:package": "node scripts/package-devices.mjs",
    "dev": "vite --port 4185 --strictPort",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4186 --strictPort",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test --grep-invert @og",
    "og": "playwright test --grep @og"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "@playwright/test": "1.60.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.5.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.1",
    "meshoptimizer": "^1.3.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.0"
  },
  "packageManager": "pnpm@11.25.0"
}
